# Copy with `make init`: this generates a unique local database password.
# Never commit .env. Environment variables are read by Docker Compose.
NEO4J_PASSWORD=
WEB_PORT=8080
API_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# `make docker-run` includes a local Ollama service and downloads this model.
# `make docker-core` uses deterministic evidence tools unless you configure a provider.
ARIADNE_AGENT_MODE=auto
ARIADNE_LLM_BASE_URL=http://ollama:11434/v1
ARIADNE_LLM_MODEL=qwen2.5:1.5b
# Default Qwen identity is pinned in infra/bootstrap_model.py. Optional pin for a custom local model:
ARIADNE_LLM_MODEL_DIGEST=
ARIADNE_LLM_API_KEY=
ARIADNE_LLM_TIMEOUT=120

# For a locally run API (`make run`) with Neo4j, export these first:
# ARIADNE_GRAPH_BACKEND=neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j
# ARIADNE_DATA_DIR=data/processed
